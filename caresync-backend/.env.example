# ============================================
# CareSync Backend — Environment Variables
# ============================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git!

# Server
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# For local dev: paste the full service account JSON as a single line string
# In Cloud Run: use Application Default Credentials (no need for this)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Email (Gmail App Password)
# Enable 2FA on Gmail, then go to: Google Account > Security > App Passwords
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Security
PASSCODE_SALT=change-this-to-a-random-secret-string
SCHEDULER_SECRET=change-this-to-another-random-secret
