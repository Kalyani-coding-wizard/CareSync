{
  "name": "caresync-workspace",
  "version": "1.0.0",
  "description": "CareSync - Smart Elderly Care & Medication Management Monorepo",
  "scripts": {
    "test": "npm --prefix caresync-backend test",
    "build": "npm --prefix caresync-backend run build && npm --prefix caresync-frontend run build",
    "build:frontend": "npm --prefix caresync-frontend run build",
